<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36}:%L - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="WARN">
      <AppenderRef ref="Console"/>
    </Root>
    <Logger name="org.filteredpush.qc.sciname" level="DEBUG" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <!-- Name and authorship comparisons: logged to standard out when running tests (e.g. individually in an IDE). -->
    <Logger name="edu.harvard.mcz.nametools" level="DEBUG" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <Logger name="org.gbif.nameparser.NameParserGBIF" level="WARN">
      <AppenderRef ref="Console"/>
    </Logger>
  </Loggers>
</Configuration>
