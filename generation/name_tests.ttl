  skos:example "dwc:scientificName=\"Eucalyptus camaldulensis\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:scientificName found in the bdqval:sourceAuthority\"",
    "dwc:scientificName=\"Capulus intort\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName was not found in the bdqval:sourceAuthority\"";
