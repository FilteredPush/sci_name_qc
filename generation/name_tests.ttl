bdqtest:f01fb3f9-2f7e-418b-9f51-adf50f202aea-2025-03-06 a bdqffdq:Amendment;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  bdqffdq:hasEnhancement bdqenh:FilledInFrom;
  skos:note "The value of dwc:scientificNameID is unambiguous if dwc:scientificNameID references a single taxon record in the bdqval:sourceAuthority. When referencing a GBIF taxon by GBIF's identifier for that taxon, use the the pseudo-namespace \"gbif:\" and the form \"gbif:{integer}\" as the value for dwc:scientificNameID. Implementers can be aware of the current GBIF api endpoint that can replace the pseduo-namespace gbif: when looking up the dwc:scientificNameID (taxonID in the gbif document), e.g. `s/gbif:/https:\\/\\/api.gbif.org\\/v1\\/species\\// ` will transform the value taxonID=gbif:8102122 to the resolvable endpoint https://api.gbif.org/v1/species/8102122. The pseudo-namespace \"gbif:\" is recommended by GBIF to reference GBIF taxon records. Where resolvable persistent identifiers exist for dwc:scientificNameID values, they should be used in full, but implementers will need to support at least the \"gbif:\" pseudo-namespace. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**";
  bdqffdq:hasDataQualityDimension bdqdim:Completeness;
  dcterms:description "Proposes an amendment to the value of dwc:scientificName using the dwc:scientificNameID value from the bdqval:sourceAuthority.";
  bdqffdq:hasActedUponInformationElement <urn:uuid:627a0c7f-9c5d-49ba-a3d1-1c8250cf1d0a>;
  bdqffdq:hasConsultedInformationElement <urn:uuid:3d82cf1d-7f1e-4844-aa69-013009b7e514>;
  dcterms:issued "2025-03-06"^^xsd:date;
  dcterms:references <urn:uuid:dc0ea725-020e-4c08-99ec-79aad970dc99>;
  skos:historyNote "https://github.com/tdwg/bdq/issues/71";
  rdfs:label "AMENDMENT_SCIENTIFICNAME_FROM_SCIENTIFICNAMEID";
  dcterms:isVersionOf bdqtest:f01fb3f9-2f7e-418b-9f51-adf50f202aea;
  skos:prefLabel "Amendment dwc:scientificName from dwc:scientificNameID for SingleRecord" .

bdqdim:Completeness a bdqffdq:DataQualityDimension;
  rdfs:label "Completeness" .

